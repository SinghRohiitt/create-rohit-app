{
  "name": "create-rohit-app",
  "version": "0.1.0",
  "description": "A CLI for scaffolding configurable full-stack applications.",
  "type": "module",
  "bin": {
    "create-rohit-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node20 --out-dir dist --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "full-stack",
    "typescript"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
