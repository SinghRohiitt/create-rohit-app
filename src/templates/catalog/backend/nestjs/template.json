{
  "id": "nestjs",
  "description": "Modular NestJS backend using TypeScript with optional Prisma, Mongoose, and JWT authentication.",
  "appliesTo": {
    "backend": "nestjs"
  },
  "destinationPrefixByProjectType": {
    "fullstack": "backend"
  },
  "order": 10,
  "files": [
    { "source": "package.json.tpl", "destination": "package.json", "template": true, "merge": "json" },
    { "source": "package.fullstack.json.tpl", "destination": "package.json", "template": false, "merge": "json", "when": { "key": "projectType", "equals": "fullstack" } },
    { "source": "package.auth.json.tpl", "destination": "package.json", "template": false, "merge": "json", "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "package.postgres.json.tpl", "destination": "package.json", "template": false, "merge": "json", "when": { "key": "database", "equals": "postgres" } },
    { "source": "package.mongodb.json.tpl", "destination": "package.json", "template": false, "merge": "json", "when": { "key": "database", "equals": "mongodb" } },
    { "source": "eslint.config.mjs.tpl", "destination": "eslint.config.mjs", "template": false },
    { "source": "tsconfig.json.tpl", "destination": "tsconfig.json", "template": false },
    { "source": "main.ts.tpl", "destination": "src/main.ts", "template": false },
    { "source": "app.service.ts.tpl", "destination": "src/app.service.ts", "template": false },
    { "source": "app.controller.ts.tpl", "destination": "src/app.controller.ts", "template": true },
    { "source": "health.controller.ts.tpl", "destination": "src/health.controller.ts", "template": false },
    { "source": "app.controller.spec.ts.tpl", "destination": "test/app.controller.spec.ts", "template": true },
    { "source": "http-exception.filter.ts.tpl", "destination": "src/common/http-exception.filter.ts", "template": false },
    { "source": "environment.validation.ts.tpl", "destination": "src/config/environment.validation.ts", "template": true },
    { "source": "app.module.none.ts.tpl", "destination": "src/app.module.ts", "template": false, "when": [{ "key": "database", "equals": "none" }, { "key": "authentication", "equals": "none" }] },
    { "source": "app.module.postgres.ts.tpl", "destination": "src/app.module.ts", "template": false, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "none" }] },
    { "source": "app.module.mongodb.ts.tpl", "destination": "src/app.module.ts", "template": false, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "none" }] },
    { "source": "app.module.postgres.auth.ts.tpl", "destination": "src/app.module.ts", "template": false, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "app.module.mongodb.auth.ts.tpl", "destination": "src/app.module.ts", "template": false, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "prisma.service.ts.tpl", "destination": "src/database/prisma.service.ts", "template": false, "when": { "key": "database", "equals": "postgres" } },
    { "source": "prisma.module.ts.tpl", "destination": "src/database/prisma.module.ts", "template": false, "when": { "key": "database", "equals": "postgres" } },
    { "source": "prisma.schema.tpl", "destination": "prisma/schema.prisma", "template": false, "when": { "key": "database", "equals": "postgres" } },
    { "source": "user.schema.mongodb.ts.tpl", "destination": "src/users/user.schema.ts", "template": false, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "user.types.ts.tpl", "destination": "src/users/user.types.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "user.service.prisma.ts.tpl", "destination": "src/users/user.service.ts", "template": false, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "user.service.mongodb.ts.tpl", "destination": "src/users/user.service.ts", "template": false, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "user.module.prisma.ts.tpl", "destination": "src/users/user.module.ts", "template": false, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "user.module.mongodb.ts.tpl", "destination": "src/users/user.module.ts", "template": false, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "auth.module.ts.tpl", "destination": "src/auth/auth.module.ts", "template": true, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "auth.controller.ts.tpl", "destination": "src/auth/auth.controller.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "auth.service.ts.tpl", "destination": "src/auth/auth.service.ts", "template": true, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "jwt.strategy.ts.tpl", "destination": "src/auth/jwt.strategy.ts", "template": true, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "jwt-auth.guard.ts.tpl", "destination": "src/auth/jwt-auth.guard.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "auth.types.ts.tpl", "destination": "src/auth/auth.types.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "register.dto.ts.tpl", "destination": "src/auth/dto/register.dto.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "login.dto.ts.tpl", "destination": "src/auth/dto/login.dto.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "auth.service.spec.ts.tpl", "destination": "test/auth.service.spec.ts", "template": false, "when": { "key": "authentication", "equals": "jwt" } },
    { "source": "env.none.tpl", "destination": ".env.example", "template": true, "when": [{ "key": "database", "equals": "none" }, { "key": "authentication", "equals": "none" }] },
    { "source": "env.postgres.tpl", "destination": ".env.example", "template": true, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "none" }] },
    { "source": "env.mongodb.tpl", "destination": ".env.example", "template": true, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "none" }] },
    { "source": "env.postgres.auth.tpl", "destination": ".env.example", "template": true, "when": [{ "key": "database", "equals": "postgres" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "env.mongodb.auth.tpl", "destination": ".env.example", "template": true, "when": [{ "key": "database", "equals": "mongodb" }, { "key": "authentication", "equals": "jwt" }] },
    { "source": "README.nestjs.tpl", "destination": "README.backend.md", "template": true }
  ]
}
